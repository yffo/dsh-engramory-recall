# 依赖与构建产物
node_modules/
*.tgz

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp

# 日志与临时文件
*.log
npm-debug.log*

# ⚠️ 记忆库绝不入库：里面是私人事实、路径与偏好。
#    本插件只读它，仓库里永远不该出现笔记内容或索引。
memory/
engramory/
MEMORY.md

# ⚠️ 写入审计（落在记忆库里，不在仓库里；这条是保险）
.engramory-audit.jsonl
.engramory-audit.jsonl.*
scripts/.probe-baseline.json

# 基准临时产物
bench/.tmp/
bench/.bench-result.json
bench/.*.json

# ⚠️ 评测题集、夹具与跑分产物绝不入库：题集是从私人记忆库**反向构题**出来的，
#    里面含真实路径、称呼与项目史（与「记忆库绝不入库」同一条纪律）。
#    可公开复现的那套在 bench/eval-sample/ —— 新克隆的人跑那一套。
bench/eval-tasks/
bench/eval-results/
