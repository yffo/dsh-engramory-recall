{
  "name": "dsh-engramory-recall",
  "version": "0.13.16",
  "description": "Local BM25 auto-recall, fail-closed write guard, static doctor and a memory panel for the Engramory markdown store — no network, no model, no daemon.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "engramory",
    "memory",
    "bm25",
    "recall",
    "markdown"
  ],
  "author": "yffto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yffo/dsh-engramory-recall.git"
  },
  "homepage": "https://github.com/yffo/dsh-engramory-recall#readme",
  "bugs": {
    "url": "https://github.com/yffo/dsh-engramory-recall/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./bm25": "./bm25.js",
    "./store": "./store.js",
    "./guard": "./guard.js",
    "./doctor": "./doctor.js",
    "./audit": "./audit.js",
    "./package.json": "./package.json",
    "./archive": "./archive.js",
    "./index-guard": "./index-guard.js",
    "./skill": "./skill.js",
    "./llm": "./llm.js",
    "./index": "./index.js",
    "./mcp": "./mcp.js",
    "./semantic": "./semantic.js",
    "./providers/openai-embeddings": "./providers/openai-embeddings.mjs",
    "./usage": "./usage.js"
  },
  "files": [
    "index.js",
    "client/client.js",
    "bm25.js",
    "store.js",
    "guard.js",
    "doctor.js",
    "audit.js",
    "archive.js",
    "index-guard.js",
    "skill.js",
    "llm.js",
    "semantic.js",
    "mcp.js",
    "providers/openai-embeddings.mjs",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "scripts/recall-stats.mjs",
    "usage.js"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-recall-wiring.mjs",
    "probe": "node scripts/recall-probe.mjs",
    "bench": "node bench/run.mjs",
    "bench:check": "node bench/run.mjs --check",
    "bench:seam": "node bench/semantic-seam.mjs",
    "bench:ceiling": "node bench/pool-ceiling.mjs",
    "bench:embed": "node bench/embed-live.mjs",
    "bench:rewrite": "node bench/host-rewrite.mjs",
    "bench:bridges": "node bench/bridge-coverage.mjs",
    "bench:mcp": "node bench/mcp-overhead.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "embed:check": "node providers/openai-embeddings.mjs --check",
    "release:verify": "node scripts/verify-release.mjs",
    "bench:probe": "node bench/probe.mjs",
    "recall:stats": "node scripts/recall-stats.mjs",
    "bench:guard": "node bench/guard-sweep.mjs"
  },
  "bin": {
    "engramory-recall-mcp": "mcp.js"
  }
}
